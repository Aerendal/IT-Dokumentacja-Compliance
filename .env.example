# .env.example — zmienne środowiskowe dla IT Dokumentacja Compliance
#
# Skopiuj do .env i uzupełnij wartości:
#   cp .env.example .env
#
# UWAGA: .env NIE jest commitowany (jest w .gitignore)

# ---------------------------------------------------------------------------
# TRYB DEBUG — ujawnia ukryte błędy w skryptach batch
# ---------------------------------------------------------------------------
#
# Domyślnie (ITDOC_STRICT=0) wyjątki w pętlach batch są łapane i logowane
# na poziomie DEBUG — skrypt kontynuuje przetwarzanie pozostałych plików.
#
# Ustaw ITDOC_STRICT=1 podczas debugowania aby batch_continue() re-rzucał
# wyjątek jako RuntimeError z pełnym łańcuchem przyczyn:
#
#   ITDOC_STRICT=1 python scripts/enrich_niche_domains.py
#   ITDOC_STRICT=1 pytest -x                      # zatrzymaj na pierwszym błędzie
#   ITDOC_STRICT=1 make test                       # lub: make strict-test
#
# Patrz: itdoc/_batch.py :: batch_continue()
#
ITDOC_STRICT=0

# ---------------------------------------------------------------------------
# ŚCIEŻKA DO BAZY DANYCH
# ---------------------------------------------------------------------------
# Domyślnie: reports/it_doc_matrix.db (względem katalogu projektu)
# Zmień jeśli korzystasz z innej lokalizacji bazy.
#
# ITDOC_DB_PATH=/ścieżka/do/it_doc_matrix.db

# ---------------------------------------------------------------------------
# POZIOM LOGOWANIA
# ---------------------------------------------------------------------------
# Wartości: DEBUG | INFO | WARNING | ERROR
# Domyślnie: WARNING (cichy tryb produkcyjny)
# Ustaw DEBUG aby zobaczyć szczegółowe logi batch_continue()
#
# ITDOC_LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# ŚRODOWISKO (opcjonalne — dla przyszłych integracji)
# ---------------------------------------------------------------------------
# ITDOC_ENV=development   # development | staging | production
